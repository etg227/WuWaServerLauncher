<Window x:Class="WuWaServerLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鸣潮多服启动器"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,26">
            <TextBlock Text="鸣潮多服启动器"
                       FontSize="30"
                       FontWeight="Bold"/>
            <TextBlock Text="Wuthering Waves Server Launcher"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="选择服务器"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ItemsControl Grid.Row="0" ItemsSource="{Binding Servers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding}"
                                Click="ServerButton_Click"
                                Style="{StaticResource ServerButton}">
                            <Grid Height="170">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="23"
                                           FontWeight="Bold"/>
                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding Region}"
                                               FontSize="12"
                                               Foreground="{StaticResource Accent}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding StatusText}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="当前选择："
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="SelectedServerText"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <TextBlock Text="客户端启动文件"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExecutablePathTextBox"
                                     Height="40"
                                     VerticalContentAlignment="Center"
                                     Padding="12,0"
                                     IsReadOnly="True"
                                     Background="#0D131B"
                                     BorderBrush="{StaticResource PanelBorder}"
                                     Foreground="{StaticResource TextPrimary}"/>
                            <Button Grid.Column="1"
                                    Content="选择 EXE"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="40"
                                    Margin="10,0,0,0"
                                    Padding="16,0"
                                    Click="BrowseButton_Click"/>
                        </Grid>
                    </StackPanel>

                    <Button Grid.Row="2"
                            x:Name="LaunchButton"
                            Content="启动"
                            Style="{StaticResource PrimaryButton}"
                            Height="48"
                            Margin="0,16,0,0"
                            Click="LaunchButton_Click"/>
                            />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="选择已安装的对应客户端即可。此版本不修改游戏文件，只负责选择并启动。"
                   FontSize="11"
                   Foreground="{StaticResource TextSecondary}"
                   Margin="0,18,0,0"/>
    </Grid>
</Window>
